%% -*- mode: erlang -*-
[
  {mtproto_proxy, [
    {ports, [
      #{name      => mtp_ipv4,
        listen_ip => "0.0.0.0",
        port      => 443,
        secret    => <<"d0d6e111bada5511fcce9584deadbeef">>,
        tag       => <<"dcbe8f1493fa4cd9ab300891c0b5b326">>},
      #{name      => mtp_ipv6,
        listen_ip => "::",
        port      => 443,
        secret    => <<"d0d6e111bada5511fcce9584deadbeef">>,
        tag       => <<"dcbe8f1493fa4cd9ab300891c0b5b326">>}
    ]},
    {allowed_protocols, [mtp_fake_tls]},
    {domain_fronting, "127.0.0.1:1443"},
    {policy, [
      {in_table, tls_domain, personal_domains},
      {max_connections, [tls_domain], 100}
    ]}
  ]},
  {personal_mtproxy, [
    %% Virtual-host configuration: one entry per base domain.
    %% Each domain needs its own wildcard TLS certificate.
    %% Paths should point to copies managed by the certbot deploy hook
    %% (see `make install`); do NOT point directly at /etc/letsencrypt/live/
    %% — the private key there is root-only readable.
    {vhosts, [
      #{domain   => "demo.personal-mtp.online",
        ssl_cert => "/var/lib/personal_mtproxy/demo.personal-mtp.online/fullchain.pem",
        ssl_key  => "/var/lib/personal_mtproxy/demo.personal-mtp.online/privkey.pem"}
      %% Add more vhosts here, e.g.:
      %% #{domain   => "prod.personal-mtp.online",
      %%   ssl_cert => "/var/lib/personal_mtproxy/prod.personal-mtp.online/fullchain.pem",
      %%   ssl_key  => "/var/lib/personal_mtproxy/prod.personal-mtp.online/privkey.pem"}
    ]},
    {dets_file, "/var/lib/personal_mtproxy/proxies.dets"},
    %% Optional: bind Cowboy on a specific address instead of inheriting domain_fronting.
    %% Useful when you want to front an unrelated site and serve the UI on a separate port.
    %% {web_listen_ip,   "127.0.0.1"},
    %% {web_listen_port, 8443}

    %% DEPRECATED (single-domain legacy format, use 'vhosts' above instead):
    %% {base_domain, "demo.personal-mtp.online"},
    %% {ssl_cert,    "/var/lib/personal_mtproxy/fullchain.pem"},
    %% {ssl_key,     "/var/lib/personal_mtproxy/privkey.pem"}
  ]},

  %% Logging config
  {kernel,
   [{logger_level, info},
    {logger,
     [{filters, log,
       [{progress, {fun logger_filters:progress/2, stop}}]},
      {handler, default, logger_std_h,
       #{level => info,
         formatter => {logger_formatter, #{single_line => true,
                         template => [time, " ", level, " ", pid, " ", mfa, ":", line, " ", msg, "\n"]}},
         config => #{type => file,
                     file => "/var/log/personal_mtproxy/application.log",
                     max_no_bytes => 104857600,  % 100MB
                     max_no_files => 10,
                     filesync_repeat_interval => no_repeat}}},
      {handler, console, logger_std_h,
       #{level => critical,
         formatter => {logger_formatter, #{single_line => true}},
         config => #{type => standard_io}}}
     ]}]},
  {sasl,
   [{errlog_type, error}]}
].
